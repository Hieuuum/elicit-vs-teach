{
  "permissions": {
    "deny": [
      "Edit(/reference/**)",
      "Write(/reference/**)",
      "NotebookEdit(/reference/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-guard.sh",
            "timeout": 10,
            "statusMessage": "agent-guard: checking stage restrictions"
          }
        ]
      }
    ]
  }
}
